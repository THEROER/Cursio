{
  "productName": "cursio",
  "version": "0.1.0",
  "identifier": "com.cursio.dev",
  "build": {
    "beforeDevCommand": "bun run --cwd ui dev",
    "beforeBuildCommand": "bun run --cwd ui generate",
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "ui/.output/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "resizable": true,
        "title": "Cursio",
        "width": 960,
        "height": 720,
        "visible": false
      }
    ],
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
