{
  "productName": "Cursio",
  "identifier": "com.cursio.dev",
  "build": {
    "beforeDevCommand": "bun run --cwd ui dev",
    "beforeBuildCommand": "bun run --cwd ui generate",
    "devUrl": "http://127.0.0.1:1430",
    "frontendDist": "ui/.output/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "resizable": true,
        "title": "Cursio",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": false,
        "visible": false
      }
    ],
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright (C) 2026 the Cursio contributors",
    "licenseFile": "../LICENSE",
    "android": {
      "minSdkVersion": 28
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
