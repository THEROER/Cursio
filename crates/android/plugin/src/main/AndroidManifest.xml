<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the Tauri app's manifest. Everything the phone's node needs
     lives here rather than in app/gen/android, which `tauri android init`
     regenerates. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The mesh is LAN-only by design, but Android gates local sockets and
         mDNS behind the ordinary network permissions all the same. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- mDNS is multicast, which Android does not deliver to an app that has
         not asked for it: without this the phone announces itself and hears
         nobody, which looks exactly like a firewall problem on the peer. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Since Android 14 the generic permission is not enough; the specific
         type must be declared too, and it must match the service's own. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Capturing what the phone plays for a peer rides a MediaProjection,
         which Android 14+ lets only a mediaProjection-typed service hold. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Since Android 13 the ongoing notification a foreground service shows
         is itself permission-gated. Denied, the service still runs. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- This phone's text messages, read and sent from a desktop; contact
         names make the conversation list readable. See SmsStore. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- SEND_SMS implies telephony is required; a tablet without a SIM is
         still a mesh member, it just has no messages to offer. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- The phone's microphone, sent to a peer. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The echo canceller and communication routing the audio backend asks
         for are audio-settings changes. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Wake and Wi-Fi locks; see MeshService.acquireLocks for why each. -->
    <!-- A phone's calls shown and handled on a computer; see CallMonitor. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- The mesh over Bluetooth: an RFCOMM socket to a paired computer, for
         when the network does not reach it. Android 12 asks for "nearby
         devices"; older releases granted plain BLUETOOTH at install. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Ringing a lost phone also shakes it; see Ringer. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Android 16 shows a ringing phone as a Live Update only with this;
         an install-time permission, asked of nobody. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- A ringing phone floats as a heads-up on skins that float nothing else;
         see Ringer. Granted at install below Android 14, an alarm's use above. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Lets the app ask for the exemption in one system dialog instead of
         sending the user through the battery settings list to find it. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- No backup: the files directory holds this node's identity and trust
         store, and restoring them onto another phone would make two devices
         answer as one peer. -->
    <application android:allowBackup="false">

        <!-- One service, every type it may ever hold. Which of them a given
             start claims is decided in MeshService.wantedTypes, because the
             platform allows different ones from boot and from the foreground. -->
        <service
            android:name="dev.cursio.mesh.MeshService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|mediaPlayback|microphone|mediaProjection" />

        <!-- "Share → Cursio" in every app's share sheet. Translucent so the
             machine picker sits over the app the user is in. -->
        <activity
            android:name="dev.cursio.mesh.ShareActivity"
            android:exported="true"
            android:label="Cursio"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- This phone's notifications, for the desktop the user is at. Runs
             only once the user grants notification access in the system's
             settings; the system binds it, so it is exported to the system
             alone through the permission. -->
        <service
            android:name="dev.cursio.mesh.CursioNotificationListener"
            android:exported="true"
            android:label="Cursio"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name="dev.cursio.mesh.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
