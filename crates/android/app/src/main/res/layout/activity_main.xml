<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- Node -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/SectionTitle"
                android:text="This phone" />

            <EditText
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Name shown to your other machines"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textColorHint="@color/text_muted"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/node_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/dot" />

                <TextView
                    android:id="@+id/node_status"
                    style="@style/Body"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Stopped" />

                <Button
                    android:id="@+id/run_button"
                    style="@style/Button"
                    android:text="Start" />
            </LinearLayout>

            <TextView
                android:id="@+id/load_error"
                style="@style/Body"
                android:layout_marginTop="8dp"
                android:textColor="@color/danger"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Setup: only what is still missing is shown. -->
        <LinearLayout
            android:id="@+id/setup_card"
            style="@style/Card">

            <TextView
                style="@style/SectionTitle"
                android:text="Keep it running" />

            <LinearLayout
                android:id="@+id/setup_notify"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Body"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Notifications are off: you will not see that the node is running." />

                <Button
                    android:id="@+id/setup_notify_button"
                    style="@style/ButtonQuiet"
                    android:text="Allow" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/setup_mic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Body"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Microphone access is needed to send this phone's mic to a computer." />

                <Button
                    android:id="@+id/setup_mic_button"
                    style="@style/ButtonQuiet"
                    android:text="Allow" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/setup_battery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Body"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Battery optimisation may stop the node while the screen is off." />

                <Button
                    android:id="@+id/setup_battery_button"
                    style="@style/ButtonQuiet"
                    android:text="Exempt" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/setup_autostart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Body"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Allow Autostart for Cursio, or HyperOS will not start it after a reboot." />

                    <Button
                        android:id="@+id/setup_autostart_button"
                        style="@style/ButtonQuiet"
                        android:text="Open" />
                </LinearLayout>

                <TextView
                    style="@style/Hint"
                    android:layout_marginTop="4dp"
                    android:text="Also set Battery saver to “No restrictions” in the app's settings, and lock Cursio in the recent apps view." />
            </LinearLayout>
        </LinearLayout>

        <!-- Peers -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/SectionTitle"
                android:text="Machines" />

            <LinearLayout
                android:id="@+id/peers_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/peers_empty"
                style="@style/Hint"
                android:text="No machines yet. Pair one below." />
        </LinearLayout>

        <!-- Pairing -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/SectionTitle"
                android:text="Pair" />

            <TextView
                style="@style/Hint"
                android:text="Enter the code shown on your computer" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/pair_code"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:hint="ABCD-EFGH"
                    android:imeOptions="actionGo"
                    android:importantForAutofill="no"
                    android:inputType="textCapCharacters|textNoSuggestions"
                    android:maxLines="1"
                    android:textColor="@color/text"
                    android:textColorHint="@color/text_muted"
                    android:textSize="20sp" />

                <Button
                    android:id="@+id/pair_button"
                    style="@style/Button"
                    android:text="Pair" />
            </LinearLayout>

            <TextView
                android:id="@+id/pair_error"
                style="@style/Body"
                android:textColor="@color/danger"
                android:visibility="gone" />

            <Button
                android:id="@+id/show_code_button"
                style="@style/ButtonQuiet"
                android:layout_marginTop="8dp"
                android:text="Show a code to enter on the computer" />

            <LinearLayout
                android:id="@+id/pairing_active"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/shown_code"
                    style="@style/Body"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:textIsSelectable="true"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pairing_state"
                    style="@style/Hint" />

                <Button
                    android:id="@+id/cancel_pair_button"
                    style="@style/ButtonQuiet"
                    android:text="Cancel" />
            </LinearLayout>

            <TextView
                android:id="@+id/last_pairing"
                style="@style/Hint"
                android:layout_marginTop="4dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Audio -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/SectionTitle"
                android:text="Audio" />

            <LinearLayout
                android:id="@+id/streams_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/streams_empty"
                style="@style/Hint"
                android:text="Nothing is playing." />

            <TextView
                style="@style/Body"
                android:layout_marginTop="16dp"
                android:text="Microphone gate" />

            <TextView
                style="@style/Hint"
                android:text="Below the gate the microphone sends silence. Auto follows the room's own noise." />

            <RadioGroup
                android:id="@+id/gate_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/gate_auto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Auto"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/gate_fixed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Fixed"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/gate_off"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Off"
                    android:textColor="@color/text" />
            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <SeekBar
                    android:id="@+id/gate_level"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="60" />

                <TextView
                    android:id="@+id/gate_value"
                    style="@style/Body"
                    android:layout_width="72dp"
                    android:fontFamily="monospace"
                    android:gravity="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/gate_error"
                style="@style/Body"
                android:textColor="@color/danger"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
