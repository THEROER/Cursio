<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The mesh is LAN-only by design, but Android gates local sockets and
         mDNS behind the ordinary network permissions all the same. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- mDNS is multicast, which Android does not deliver to an app that has
         not asked for it: without this the phone announces itself and hears
         nobody, which looks exactly like a firewall problem on the peer. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Since Android 14 the generic permission is not enough; the specific
         type must be declared too, and it must match the service's own. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Since Android 13 the ongoing notification a foreground service shows
         is itself permission-gated. Denied, the service still runs. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name="dev.cursio.mesh.MeshService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
