# Copy to .env (ignored by git) and fill in. `cargo xtask deploy` and
# `cargo xtask live-test` read these; a flag of the same name overrides them.

# ssh destination of the Windows peer's WSL, and its port.
CURSIO_PEER_SSH=user@192.168.1.2
CURSIO_PEER_SSH_PORT=22
# The Windows user's home as WSL sees it.
CURSIO_PEER_WIN_HOME=/mnt/c/Users/user
# The peer's name in the mesh (its mount lives at ~/Cursio/<name>).
CURSIO_PEER_NAME=Laptop
